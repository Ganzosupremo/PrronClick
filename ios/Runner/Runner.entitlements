<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Link finds peers by multicast and the leader shares the bar by UDP
	     broadcast; iOS blocks both without this. Apple must grant it to the
	     team first: developer.apple.com/contact/request/networking-multicast -->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
